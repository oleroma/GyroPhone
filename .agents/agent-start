#!/usr/bin/env bash
# Step 1: make a feature branch from the latest dev and open a draft PR into dev.
# Usage: .agents/agent-start [--continue] <feature-name>
#   --continue  skip the check for other agents' draft PRs (Olex said not to wait)
source "$(dirname "$0")/lib.sh"
cd "$WORKTREE"

skip_check=0
if [ "${1:-}" = "--continue" ]; then
  skip_check=1
  shift
fi
name="${1:-}"
[ -n "$name" ] || die "Usage: agent-start [--continue] <feature-name>"
git check-ref-format --branch "$name" >/dev/null || die "\"$name\" isn't a valid branch name."
case "$name" in
  main | dev) die "Pick a feature name, not $name." ;;
esac
[ -z "$(git status --porcelain)" ] || die "There are uncommitted changes. Commit them with agent-commit, or ask Olex."

git fetch origin --prune

if [ "$skip_check" = 0 ]; then
  drafts="$(gh pr list --base dev --state open --draft --json number,headRefName,url \
    --jq '.[] | "#\(.number) \(.headRefName) \(.url)"')"
  if [ -n "$drafts" ]; then
    finish other-agent "Open draft PRs into dev:" "$drafts"
  fi
fi

created_dev=""
if ! git ls-remote --exit-code --heads origin dev >/dev/null; then
  git push origin "origin/main:refs/heads/dev"
  git fetch origin dev
  created_dev=" (dev was missing, so it was created from main)"
fi

if git show-ref --verify --quiet "refs/heads/$name" ||
  git ls-remote --exit-code --heads origin "$name" >/dev/null; then
  die "A branch named $name already exists. Pick another name."
fi

git switch --no-track -c "$name" origin/dev
# GitHub won't open a PR without a commit, so the branch starts with an empty one.
git commit --allow-empty -m "Start $name"
git push -u origin "$name"
url="$(gh pr create --draft --base dev --head "$name" --title "$name" --body "Work in progress by an agent.")"

finish done "Branch $name made from dev at $(git rev-parse --short origin/dev)$created_dev." "Draft PR: $url"
