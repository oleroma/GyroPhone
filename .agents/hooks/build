#!/usr/bin/env bash
# Builds GyroPhone and prints "build-file: <path> <version>" per build file.
# Usage: build [apk|companion|driver]
#   no argument: the parts this branch changed (see parts); the companion and driver only on Windows
#   apk / companion / driver: only that one (the fallback workflow builds them on separate runners)
# A part that isn't built has no build file, so agent-install leaves it as installed.
set -euo pipefail
cd "$(dirname "$0")/../.."
if [ $# -gt 0 ]; then parts="$*"; else parts="$(bash .agents/hooks/parts)"; fi

# The version is 0.1.<build number>, read by app/build.gradle.kts and stamped into the companion.
# BUILD_NUMBER comes from .agents/build-number, run by agent-build pc and fallback.yml.
GP_BUILD="${BUILD_NUMBER:?Set by agent-build pc and fallback.yml from .agents/build-number}"
GP_COMMIT="$(git rev-parse --short=7 HEAD)"
export GP_BUILD GP_COMMIT
version="0.1.$GP_BUILD"

if grep -qw apk <<<"$parts"; then
  # The signing key, kept outside the repo: CI passes it from the repo's secrets; on the PC it comes
  # from ~/.android-keys/gyrophone.env. Without it the APK couldn't update the installed app, so stop.
  if [ -z "${ANDROID_KEYSTORE:-}" ] && [ -f "$HOME/.android-keys/gyrophone.env" ]; then
    { set +x; } 2>/dev/null
    . "$HOME/.android-keys/gyrophone.env"
  fi
  [ -n "${ANDROID_KEYSTORE:-}" ] && [ -f "$ANDROID_KEYSTORE" ] ||
    { echo "No signing key: put it in ~/.android-keys/gyrophone.jks and gyrophone.env (see app/build.gradle.kts)." >&2; exit 1; }
  # The release build type: not debuggable (Android runs debuggable apps with most speed-ups off),
  # no R8, signed with that key like every build, so adb install -r keeps app data.
  ./gradlew :app:assembleRelease
  apk="app/build/outputs/apk/release/gyrophone-$version.apk"
  cp app/build/outputs/apk/release/app-release.apk "$apk"
  echo "build-file: $apk $version"
fi

if grep -qw companion <<<"$parts" && { [ $# -gt 0 ] || [ "${OS:-}" = Windows_NT ]; }; then
  # Every build (branch and main) is ReadyToRun, so the companion's own code isn't compiled at each
  # start, and uncompressed, so the exe's parts are mapped in place instead of unpacked at each start
  # (a bigger exe, a faster start). The publish takes longer, but only when the companion changed.
  # OpenCV's native DLLs (latency test only) stay out of the exe (GyroPhone.Tray.csproj) and ship
  # beside it as build files of their own.
  publish=(dotnet publish companion/src/GyroPhone.Tray -c Release -r win-x64 --self-contained true
    -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true
    -p:PublishReadyToRun=true -p:DebugType=none)
  out=companion/out
  # The companion is built only from companion/src, companion/Directory.Build.props and the
  # publish settings above. When none of them changed since the exe in companion/out was built,
  # that exe (and the DLLs beside it) is reused as is, keeping its own (older) version, and the
  # install hook leaves the installed companion alone. The version and commit stamped into the exe aren't part of the key.
  key="$(git rev-parse HEAD:companion/src HEAD:companion/Directory.Build.props | tr '\n' ' ')$(printf '%s ' "${publish[@]}" | git hash-object --stdin)"
  if [ -f "$out/GyroPhoneCompanion.exe" ] && [ -f "$out/source-key.txt" ] && [ "$(cat "$out/source-key.txt")" = "$key" ]; then
    echo "Companion sources unchanged: reusing companion/out/GyroPhoneCompanion.exe." >&2
  else
    if [ -f "$out/source-key.txt" ]; then : >"$out/source-key.txt"; fi
    "${publish[@]}" -p:Version="$version" -p:InformationalVersion="$version-$GP_COMMIT" \
      -p:IncludeSourceRevisionInInformationalVersion=false -o "$out"
    echo "$key" >"$out/source-key.txt"
  fi
  echo "build-file: $out/GyroPhoneCompanion.exe $version"
  # The DLLs beside the exe, as the publish listed them (not any an older publish left in companion/out).
  if [ -f "$out/side-files.txt" ]; then
    while read -r f; do
      if [ -n "$f" ]; then echo "build-file: $out/$f $version"; fi
    done < <(tr -d '\r' <"$out/side-files.txt")
  fi
fi

if grep -qw driver <<<"$parts" && { [ $# -gt 0 ] || [ "${OS:-}" = Windows_NT ]; }; then
  # The optional GyroPhone drivers, each a UMDF 2 DLL, its INF and an unsigned catalog, zipped with
  # install.cmd / uninstall.cmd: the pad driver (driver/, GyroPhonePad) and the input driver
  # (input-driver/, GyroPhoneInput, the virtual mouse and keyboard). The PC that installs one signs
  # it with its own key (install.ps1). Each is rebuilt only when its own folder changed.
  # The Windows Driver Kit comes from NuGet into build/driver/packages (kept, never cleaned, shared
  # by both); the C++ compiler from the Visual Studio (Build Tools) that has MSVC. Nothing is
  # installed system wide.
  # Windows' own tar (bsdtar) reads and writes zips; Git Bash's GNU tar doesn't.
  wintar=/c/Windows/System32/tar.exe
  packages_ready=0
  msbuild=""

  driver_tools() {
    [ "$packages_ready" = 1 ] && return 0
    mkdir -p build/driver/packages
    # driver/packages.config lists them; a package is a zip, unpacked to <id>.<version>.
    local id ver dir
    while read -r id ver; do
      dir="build/driver/packages/$id.$ver"
      [ -d "$dir" ] && continue
      echo "Downloading $id $ver from NuGet..." >&2
      curl -fsSL --retry 3 -o "build/driver/packages/$id.$ver.nupkg" "https://www.nuget.org/api/v2/package/$id/$ver"
      mkdir -p "$dir.part"
      "$wintar" -xf "build/driver/packages/$id.$ver.nupkg" -C "$dir.part"
      mv "$dir.part" "$dir"
      rm -f "build/driver/packages/$id.$ver.nupkg"
    done < <(sed -n 's/.*<package id="\([^"]*\)" version="\([^"]*\)".*/\1 \2/p' driver/packages.config)

    local vswhere="/c/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"
    msbuild="$("$vswhere" -latest -products '*' -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 \
      -find 'MSBuild\**\Bin\amd64\MSBuild.exe' | tr -d '\r' | head -n 1)"
    [ -n "$msbuild" ] || { echo "No Visual Studio (Build Tools) with the C++ x64 compiler found: the drivers need it." >&2; exit 1; }
    packages_ready=1
  }

  # build_driver <source folder> <name> <build folder>: prints the build-file line of <name>-driver.zip.
  build_driver() {
    local src="$1" name="$2" dd="$3"
    local zip="$dd/$name-driver.zip" key
    key="$(git rev-parse "HEAD:$src")"
    if [ -f "$zip" ] && [ -f "$dd/source-key.txt" ] && [ "$(cat "$dd/source-key.txt")" = "$key" ]; then
      echo "$name sources unchanged: reusing $zip." >&2
    else
      driver_tools
      mkdir -p "$dd"
      if [ -f "$dd/source-key.txt" ]; then : >"$dd/source-key.txt"; fi
      rm -rf "$dd/obj" "$dd/out" "$dd/pkg"
      mkdir -p "$dd/obj" "$dd/out" "$dd/pkg"
      MSYS_NO_PATHCONV=1 "$msbuild" "$src/$name.vcxproj" -nologo -v:minimal -m \
        -p:Configuration=Release -p:Platform=x64 \
        -p:GpOutDir="$(cygpath -m "$PWD/$dd/out")/" -p:GpIntDir="$(cygpath -m "$PWD/$dd/obj")/" \
        -p:GpDriverVersion="0.1.$GP_BUILD.0"

      # The built DLL and the INF the WDK stamped (version, UMDF version), wherever it put them.
      local dll inf inf2cat
      dll="$(find "$dd/out" "$dd/obj" -iname "$name.dll" | head -n 1)"
      inf="$(find "$dd/out" "$dd/obj" -iname "$name.inf" | head -n 1)"
      [ -n "$dll" ] && [ -n "$inf" ] || { echo "The driver build made no $name.dll or .inf." >&2; exit 1; }
      cp "$dll" "$inf" "$dd/pkg/"
      inf2cat="$(find build/driver/packages -ipath '*x86*' -iname Inf2Cat.exe | head -n 1)"
      [ -n "$inf2cat" ] || { echo "Inf2Cat.exe not found in the WDK package." >&2; exit 1; }
      MSYS_NO_PATHCONV=1 "$inf2cat" /driver:"$(cygpath -w "$PWD/$dd/pkg")" /os:10_X64 /uselocaltime
      [ -n "$(find "$dd/pkg" -maxdepth 1 -iname "$name.cat")" ] || { echo "Inf2Cat made no catalog for $name." >&2; exit 1; }
      cp "$src/install.cmd" "$src/install.ps1" "$src/uninstall.cmd" "$src/uninstall.ps1" "$src/common.ps1" "$src/README.md" "$dd/pkg/"
      echo "$version-$GP_COMMIT" >"$dd/pkg/VERSION.txt"
      rm -f "$zip"
      (cd "$dd/pkg" && "$wintar" -a -cf "../$name-driver.zip" -- *)
      echo "$key" >"$dd/source-key.txt"
    fi
    echo "build-file: $zip $version"
  }

  build_driver driver GyroPhonePad build/driver
  build_driver input-driver GyroPhoneInput build/input-driver
fi
