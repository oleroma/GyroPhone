#!/usr/bin/env bash
# Run by agent-install (the APK is already on the phone):
#   install <version>-<commit> <build file>...
# 1. Installs the companion on this PC at %LOCALAPPDATA%\Programs\GyroPhone, one fixed path,
#    so its firewall rule and Start with Windows entry survive updates. A running exe is never
#    touched (it reads parts of itself by path while it runs): the new build waits next to it
#    as GyroPhoneCompanion.exe.new, and the running companion (or watcher) shuts down, copies
#    it into place and starts again within a few seconds, even with a phone connected
#    (pairing and settings live in %APPDATA%\GyroPhone).
# 2. Swaps the key files over adb, so the phone connects over Wi-Fi without a code: the
#    phone's phone.pub goes to %APPDATA%\GyroPhone\authorized_phones and the PC's host.pub
#    to the phone's keys/trusted_hosts. Only public keys are copied.
# Never starts or closes the apps, except --init-keys, which makes the PC key and exits.
# Prints "note: <text>" lines for the build summary.
set -euo pipefail
cd "$(dirname "$0")/../.."
export MSYS_NO_PATHCONV=1

note() { echo "note: $*"; }

ver="$1"
shift
exe=""
for f in "$@"; do
  case "$f" in */GyroPhoneCompanion.exe) exe="$f" ;; esac
done

if [ "${OS:-}" != Windows_NT ]; then
  note "Not on Windows: the companion isn't installed and no keys are swapped."
  exit 0
fi

app="$(cygpath -u "$LOCALAPPDATA")/Programs/GyroPhone"
app_exe="$app/GyroPhoneCompanion.exe"
export APP_W APP_EXE_W
APP_W="$(cygpath -w "$app")"
APP_EXE_W="$(cygpath -w "$app_exe")"

# ---- PC: the companion ----
# True when a companion or watcher runs from the installed exe. A process whose path can't be
# read (an elevated one) counts as running, so its exe is left alone.
companion_running() {
  powershell -NoProfile -Command '$p = @(Get-Process -Name GyroPhoneCompanion -ErrorAction SilentlyContinue | Where-Object { -not $_.Path -or $_.Path -eq $env:APP_EXE_W }); if ($p.Count -gt 0) { exit 0 } else { exit 1 }'
}

install_companion() {
  if [ -z "$exe" ]; then
    note "This build has no companion."
    return
  fi
  mkdir -p "$app"
  # VERSION.txt names the build at app_exe (comparing the big exes byte by byte is slow).
  local have="" f
  if [ -f "$app_exe" ] && [ -f "$app/VERSION.txt" ]; then have="$(head -n 1 "$app/VERSION.txt" | tr -d '\r')"; fi
  # A build still waiting as .new isn't in place yet (its update failed): installing it again retries it.
  if [ "$have" = "$ver" ] && [ ! -e "$app_exe.new" ]; then
    note "Companion $ver is already installed on the PC."
  else
    # .old files are left by builds that renamed the running exe; any still in use go next time.
    for f in "$app"/GyroPhoneCompanion.exe*.old; do
      if [ -e "$f" ]; then rm -f "$f" 2>/dev/null || true; fi
    done
    cp "$exe" "$app_exe.new.tmp"
    if [ -f "$app_exe" ] && companion_running; then
      mv -f "$app_exe.new.tmp" "$app_exe.new"
      note "Companion $ver installed on the PC next to the running one, which shuts down, updates and starts again within a few seconds."
    else
      mv -f "$app_exe.new.tmp" "$app_exe"
      if [ -e "$app_exe.new" ]; then rm -f "$app_exe.new" 2>/dev/null || true; fi
      note "Companion $ver installed on the PC."
    fi
    printf '%s\r\n' "$ver" >"$app/VERSION.txt"
  fi
  powershell -NoProfile -Command '$s = (New-Object -ComObject WScript.Shell).CreateShortcut([Environment]::GetFolderPath("Programs") + "\GyroPhone Companion.lnk"); $s.TargetPath = $env:APP_EXE_W; $s.WorkingDirectory = $env:APP_W; $s.Save()' ||
    note "Couldn't create the Start menu shortcut."
}

# ---- Key pairing ----
swap_keys() {
  local phone_keys=/sdcard/Android/data/com.oleroma.gyrophone/files/keys
  local gp_data
  gp_data="$(cygpath -u "$APPDATA")/GyroPhone"

  if ! command -v adb >/dev/null 2>&1 ||
    [ "$(adb devices | awk 'NR > 1 && $2 == "device"' | wc -l | tr -d ' ')" != 1 ]; then
    note "Key pairing skipped: no single phone connected over adb."
    return
  fi

  # A PC whose companion never ran has no key yet: the companion makes it and exits at once
  # (--init-keys opens no window and starts nothing). Builds that know the flag say so in
  # the exe's file properties.
  if [ ! -f "$gp_data/host.pub" ] && [ -f "$app_exe" ] &&
    powershell -NoProfile -Command 'if ((Get-Item -LiteralPath $env:APP_EXE_W).VersionInfo.Comments -like "*--init-keys*") { exit 0 } else { exit 1 }'; then
    "$app_exe" --init-keys || true
  fi
  if [ ! -f "$gp_data/host.pub" ]; then
    note "Key pairing: the PC has no key yet. Start GyroPhone Companion once, then run agent-install again."
    return
  fi

  local tmp
  tmp="$(mktemp)"
  if ! adb pull "$phone_keys/phone.pub" "$(cygpath -w "$tmp")" >/dev/null 2>&1 || [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    note "Key pairing: the phone has no key yet. Open GyroPhone once, then run agent-install again."
    return
  fi

  # The file is named after the phone (the name in phone.pub, made safe for a file name).
  local name dest
  name="$(PUB_W="$(cygpath -w "$tmp")" powershell -NoProfile -Command '$p = (Get-Content -LiteralPath $env:PUB_W -TotalCount 1) -split " ", 3; $n = if ($p.Count -ge 3) { $p[2] } else { "phone" }; $n = ($n -replace "[^\w .-]", "_").Trim(" ."); if (-not $n) { $n = "phone" }; $n' | tr -d '\r')"
  [ -n "$name" ] || name=phone
  mkdir -p "$gp_data/authorized_phones"
  dest="$gp_data/authorized_phones/$name.pub"
  # Overwrite only when it changed, so the companion isn't poked for nothing.
  if ! cmp -s "$tmp" "$dest"; then cp "$tmp" "$dest"; fi
  rm -f "$tmp"

  adb shell mkdir -p "$phone_keys/trusted_hosts" >/dev/null 2>&1 || true
  if adb push "$(cygpath -w "$gp_data/host.pub")" "$phone_keys/trusted_hosts/$COMPUTERNAME.pub" >/dev/null 2>&1; then
    note "Key pairing: phone and PC know each other."
  else
    note "Key pairing: couldn't copy the key files; code pairing still works."
  fi
}

install_companion
swap_keys
