;
; GyroPhone input driver: a virtual mouse and keyboard, a user-mode (UMDF 2) driver on Windows'
; Virtual HID Framework. Separate from the pad driver (driver/): its own package, device and service.
; Installed by install.ps1 on a root device with hardware id Root\GyroPhoneInput.
; The settings in GyroPhoneInput_HW_AddReg follow Microsoft's UMDF VHF sample (DMF VirtualHidDeviceVhfDmfU).
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=01/01/2026,1.0.0.0
CatalogFile=GyroPhoneInput.cat
PnpLockdown=1

[Manufacturer]
%Provider%=GyroPhone,NT$ARCH$.10.0...19041

[GyroPhone.NT$ARCH$.10.0...19041]
%DeviceDesc%=GyroPhoneInput_Install,Root\GyroPhoneInput

[SourceDisksNames]
1=%DiskDesc%,,,

[SourceDisksFiles]
GyroPhoneInput.dll=1

[DestinationDirs]
UMDriverCopy=13

[UMDriverCopy]
GyroPhoneInput.dll

[GyroPhoneInput_Install.NT]
CopyFiles=UMDriverCopy

[GyroPhoneInput_Install.NT.HW]
AddReg=GyroPhoneInput_HW_AddReg

[GyroPhoneInput_HW_AddReg]
; Windows' VHF below our driver, in its user-mode flavour.
HKR,,"LowerFilters",0x00010000,"vhf"
HKR,,VhfMode,0x00010001,0x1
; System and administrators: full access. Nobody else: install.ps1 then adds read and write for the one
; user who installed it (the companion's), since what this device sends reaches elevated windows and UAC.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[GyroPhoneInput_Install.NT.Services]
; The reflector service, from Windows' own wudfrd.inf (as in Microsoft's UMDF 2 samples).
Include=wudfrd.inf
Needs=WUDFRD.NT.Services

[GyroPhoneInput_Install.NT.Wdf]
UmdfService=GyroPhoneInput,GyroPhoneInput_UmdfInstall
UmdfServiceOrder=GyroPhoneInput
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2
UmdfHostPriority=PriorityHigh

[GyroPhoneInput_UmdfInstall]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\GyroPhoneInput.dll

[Strings]
Provider="GyroPhone"
DeviceDesc="GyroPhone virtual mouse and keyboard"
DiskDesc="GyroPhone input driver"
