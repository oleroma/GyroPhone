<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tray app (GyroPhoneCompanion.exe). WinForms: builds on Windows only (CI windows-latest). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Hosts the WPF windows from GyroPhone.Ui. WPF drops the System.IO implicit using: put it back. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>GyroPhone.Tray</RootNamespace>
    <AssemblyName>GyroPhoneCompanion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>GyroPhone.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- update.cmd reads this (file properties, Comments) to know the exe takes the flag before it runs it. -->
    <Description>GyroPhone Companion; supports --init-keys</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GyroPhone.Protocol/GyroPhone.Protocol.csproj" />
    <ProjectReference Include="../GyroPhone.Host/GyroPhone.Host.csproj" />
    <ProjectReference Include="../GyroPhone.Windows/GyroPhone.Windows.csproj" />
    <ProjectReference Include="../GyroPhone.Ui/GyroPhone.Ui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- Overlay windows drawn by the graphics card: Direct2D into a GDI-compatible texture. -->
    <PackageReference Include="Vortice.Direct2D1" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <!-- OpenCV's native library for the latency test's video analyser (GyroPhone.Latency). -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>
  <!-- OpenCV's native DLLs (about 95 MB, used only by the latency test) stay out of the single-file exe and
       ship beside it. Bundled, every new build would first write them out to %TEMP%\.net on its first start
       (and the antivirus scan them), for the companion and again for the update finisher. The install hook
       copies them next to the exe, and the update finisher puts in any that wait as "<dll>.new". -->
  <Target Name="KeepOpenCvOutOfTheBundle" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(Filename)%(Extension)' == 'OpenCvSharpExtern.dll' Or $([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <!-- Names them in side-files.txt in the publish folder, so the build hook ships exactly these (a DLL an
       older publish left there isn't one). -->
  <Target Name="ListSideFiles" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_GpSideFile Include="@(ResolvedFileToPublish->'%(RelativePath)')" Condition="'%(ResolvedFileToPublish.ExcludeFromSingleFile)' == 'true' And '%(Extension)' == '.dll'" />
    </ItemGroup>
    <WriteLinesToFile File="$(PublishDir)side-files.txt" Lines="@(_GpSideFile)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <!-- The FPS helper (GyroPhone.FrameHelper) rides inside the published exe; "Set up FPS helper" copies it to
       Program Files. Published on its own first (native AOT, a few MB), with its own settings, not the companion's:
       the publish's self-extract, ReadyToRun and output folder must not reach it. Plain builds (tests) skip it. -->
  <Target Name="EmbedFpsHelper" BeforeTargets="PrepareForBuild" Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <_GpHelperProject>$(MSBuildProjectDirectory)/../GyroPhone.FrameHelper/GyroPhone.FrameHelper.csproj</_GpHelperProject>
      <_GpHelperDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)fps-helper/</_GpHelperDir>
      <_GpHelperProps>Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishAot=true;PublishSingleFile=false;IncludeNativeLibrariesForSelfExtract=false;PublishReadyToRun=false;DebugType=none;PublishDir=$(_GpHelperDir)</_GpHelperProps>
    </PropertyGroup>
    <MSBuild Projects="$(_GpHelperProject)" Targets="Restore" Properties="$(_GpHelperProps);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(_GpHelperProject)" Targets="Publish" Properties="$(_GpHelperProps)" />
    <ItemGroup>
      <EmbeddedResource Include="$(_GpHelperDir)GyroPhoneFpsHelper.exe" LogicalName="GyroPhoneFpsHelper.exe" />
    </ItemGroup>
  </Target>
</Project>
