<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host engine: UDP server, pairing, sessions and injection logic behind abstractions. No Windows APIs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GyroPhone.Host</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GyroPhone.Protocol/GyroPhone.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GyroPhone.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The phone overlay's real-look models (Model3D.Shipped). -->
    <EmbeddedResource Include="Models3D/*.glb" LogicalName="GyroPhone.Host.Models3D.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
</Project>
