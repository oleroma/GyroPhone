<Project Sdk="Microsoft.NET.Sdk">
  <!-- The FPS helper (GyroPhoneFpsHelper.exe): the one part that runs as administrator, started by a Windows task
       at sign-in, so the companion gets the game's frames without admin (docs/spec/pc-companion.md, "Performance").
       Native AOT: one small exe with no .NET runtime to load anything from the user's folders or environment.
       The companion's publish builds it and carries it inside GyroPhoneCompanion.exe (GyroPhone.Tray.csproj). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>GyroPhone.FrameHelper</RootNamespace>
    <AssemblyName>GyroPhoneFpsHelper</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StartupHookSupport>false</StartupHookSupport>
    <Description>GyroPhone FPS helper</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GyroPhone.Windows/EtwPresents.cs" Link="EtwPresents.cs" />
    <Compile Include="../GyroPhone.Windows/FrameHelperWire.cs" Link="FrameHelperWire.cs" />
  </ItemGroup>
</Project>
