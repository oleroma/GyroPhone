<Project Sdk="Microsoft.NET.Sdk">
  <!-- The video latency test: the test window (a green bar that follows GyroPhone's mouse) and the video
       analyser, started by latency-test.bat. Windows only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GyroPhone.LatencyTest</RootNamespace>
    <AssemblyName>LatencyTest</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Analysis/GyroPhone.Latency.csproj" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
